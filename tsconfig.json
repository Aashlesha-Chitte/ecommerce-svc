{
  "compilerOptions": {
    "target": "ES2020", // Set the JavaScript version you want the output to be
    "module": "commonjs",
    "outDir": "./dist", // Ensure that this points to your dist directory
    "rootDir": "./src", // This should point to the directory with the TypeScript source files
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],  // Make sure the source files are correctly included
  "exclude": ["node_modules", "**/*.spec.ts"]
}